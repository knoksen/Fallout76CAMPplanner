<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FO76CampPlanner</AssemblyName>
    <RootNamespace>FO76CampPlanner</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <!-- Version Metadata -->
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>FO76 CAMP Planner</Product>
    <Company>Knoksen</Company>
    <Authors>Knoksen</Authors>
    <Description>A powerful tool for planning and visualizing Fallout 76 CAMP layouts with advanced placement rules, budget tracking, blueprints, and analysis overlays.</Description>
    <PackageProjectUrl>https://github.com/knoksen/Fallout76CAMPplanner</PackageProjectUrl>
    <RepositoryUrl>https://github.com/knoksen/Fallout76CAMPplanner</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright © 2026 Knoksen. Licensed under the MIT License.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>
</Project>
